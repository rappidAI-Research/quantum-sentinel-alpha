{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rappidai-research.com/schemas/quantum-sentinel-alpha/eval-prediction-v1.json",
  "title": "Quantum Sentinel Alpha Evaluation Prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "decision", "finding", "patch_verification"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "decision": {
      "description": "invalid = the model output violated the output contract; it is scored as a failure, never repaired.",
      "enum": ["finding", "no_finding", "abstain", "invalid"]
    },
    "error": {"type": "string", "minLength": 1},
    "finding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["cwe", "start_line", "end_line", "confidence"],
      "properties": {
        "cwe": {"type": "string", "pattern": "^(CWE-[1-9][0-9]*|unknown)$"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "patch_verification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["applied", "functional_tests_passed", "security_tests_passed", "regression_free"],
      "properties": {
        "applied": {"type": "boolean"},
        "functional_tests_passed": {"type": "boolean"},
        "security_tests_passed": {"type": "boolean"},
        "regression_free": {"type": "boolean"}
      }
    }
  }
}
