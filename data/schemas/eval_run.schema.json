{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rappidai-research.com/schemas/quantum-sentinel-alpha/eval-run-v1.json",
  "title": "Quantum Sentinel Alpha QuickEval Run Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version",
    "kind",
    "created_at",
    "reportable",
    "reportable_blockers",
    "git",
    "model",
    "runtime",
    "generation",
    "contract",
    "cases",
    "bakeoff",
    "metrics",
    "efficiency",
    "coding_regression",
    "predictions"
  ],
  "$defs": {
    "nullable_number": {"type": ["number", "null"]},
    "nullable_count": {"type": ["integer", "null"], "minimum": 0}
  },
  "properties": {
    "artifact_version": {"const": "1.0"},
    "kind": {"const": "quantum-sentinel-alpha.quickeval-run"},
    "created_at": {"type": "string", "minLength": 1},
    "reportable": {"type": "boolean"},
    "reportable_blockers": {"type": "array", "items": {"type": "string"}},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "backend"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "backend": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["device", "dtype", "quantization", "backend"],
      "properties": {
        "device": {"type": "string"},
        "dtype": {"type": "string"},
        "quantization": {"type": "string"},
        "backend": {"type": "string"},
        "resolved_revision": {"type": ["string", "null"]}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_new_tokens", "do_sample", "temperature", "top_p", "top_k", "enable_thinking", "seed"],
      "properties": {
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "do_sample": {"type": "boolean"},
        "temperature": {"$ref": "#/$defs/nullable_number"},
        "top_p": {"$ref": "#/$defs/nullable_number"},
        "top_k": {"type": ["integer", "null"]},
        "enable_thinking": {"type": "boolean"},
        "seed": {"type": "integer"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_version", "prompt_sha256", "parser_version", "scorer_version"],
      "properties": {
        "prompt_version": {"type": "string"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parser_version": {"type": "string"},
        "scorer_version": {"type": "string"}
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "count", "by_expected_decision", "by_language", "by_source_kind"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "count": {"type": "integer", "minimum": 0},
        "by_expected_decision": {"type": "object", "additionalProperties": {"type": "integer"}},
        "by_language": {"type": "object", "additionalProperties": {"type": "integer"}},
        "by_source_kind": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "bakeoff": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "candidate", "config_sha256", "runtime_override_reason"],
      "properties": {
        "id": {"type": "string"},
        "candidate": {"type": "string"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_override_reason": {"type": ["string", "null"]}
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "cases",
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative",
        "invalid_predictions",
        "precision",
        "false_positive_rate",
        "recall",
        "f1",
        "localization_top1",
        "localization_mean_overlap",
        "cwe_accuracy",
        "explicit_abstention_recall",
        "abstention_precision",
        "invalid_rate"
      ],
      "additionalProperties": {"type": ["number", "null", "object"]}
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_load_seconds",
        "total_eval_seconds",
        "mean_case_latency_seconds",
        "generated_tokens",
        "tokens_per_second",
        "peak_vram_gib"
      ],
      "properties": {
        "model_load_seconds": {"type": "number", "minimum": 0},
        "total_eval_seconds": {"type": "number", "minimum": 0},
        "mean_case_latency_seconds": {"$ref": "#/$defs/nullable_number"},
        "generated_tokens": {"$ref": "#/$defs/nullable_count"},
        "tokens_per_second": {"$ref": "#/$defs/nullable_number"},
        "peak_vram_gib": {"$ref": "#/$defs/nullable_number"}
      }
    },
    "coding_regression": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["not_run", "completed"]}}
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "expected_decision", "prediction", "evidence", "output", "latency_seconds", "generated_tokens", "prompt_tokens"],
        "properties": {
          "case_id": {"type": "string"},
          "expected_decision": {"enum": ["finding", "no_finding", "abstain"]},
          "prediction": {"type": "object"},
          "evidence": {"type": ["string", "null"]},
          "output": {"type": "string"},
          "latency_seconds": {"type": "number", "minimum": 0},
          "generated_tokens": {"$ref": "#/$defs/nullable_count"},
          "prompt_tokens": {"$ref": "#/$defs/nullable_count"}
        }
      }
    }
  }
}
