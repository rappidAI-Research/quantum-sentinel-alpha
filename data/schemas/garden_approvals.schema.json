{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rappidai-research.com/schemas/quantum-sentinel-alpha/garden-approvals-v1.json",
  "title": "Sentinel Garden Repository Approvals",
  "description": "Human rights/terms review decisions per upstream repository. Absence of an entry means not approved (default-deny). An approval is bound to the exact license file content it reviewed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvals_version",
    "repositories"
  ],
  "properties": {
    "approvals_version": {
      "const": "1.0"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_key",
          "decision",
          "license_spdx",
          "license_file",
          "license_file_sha256",
          "terms_status",
          "redistribution_status",
          "reviewer",
          "reviewed_at",
          "evidence_urls",
          "notes"
        ],
        "properties": {
          "repository_key": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"
          },
          "decision": {
            "enum": [
              "approved_for_training",
              "blocked"
            ]
          },
          "license_spdx": {
            "type": "string",
            "minLength": 1
          },
          "license_file": {
            "type": "string",
            "minLength": 1
          },
          "license_file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "terms_status": {
            "enum": [
              "approved_for_project",
              "blocked"
            ]
          },
          "redistribution_status": {
            "enum": [
              "not_redistributed",
              "approved",
              "blocked"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "notes": {
            "type": "string"
          },
          "non_permissive_justification": {
            "description": "Required when the reviewer-confirmed license is not permissive (copyleft, unknown, custom): the written policy or legal basis for training on it.",
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
